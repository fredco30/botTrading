[Unit]
Description=Donchian breakout trading bot
Documentation=file:/opt/donchian-bot/live/README.md
# Le bot a besoin du reseau et d'une horloge juste : les bougies sont datees en
# UTC et un decalage d'horloge fait lire les mauvaises barres.
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=donchian
Group=donchian
WorkingDirectory=/opt/donchian-bot

# Les cles API vivent ici, en 0600, hors du depot git.
EnvironmentFile=/etc/donchian-bot/env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/donchian-bot/.venv/bin/python run_bot.py --config /etc/donchian-bot/config.json

# SIGTERM declenche l'arret propre : le cycle en cours se termine et l'etat est
# ecrit avant la sortie. 120 s laissent le temps a un cycle complet sur 8 paires.
KillSignal=SIGTERM
TimeoutStopSec=120

# Un bot de tendance qui reste arrete laisse des positions ouvertes sans stop
# surveille. On redemarre toujours, et sans limite : StartLimitBurst par defaut
# ferait abandonner systemd apres 5 echecs rapides, exactement le cas ou il ne
# faut surtout pas abandonner.
Restart=always
RestartSec=30
StartLimitIntervalSec=0

# --- durcissement ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Seuls ces chemins sont accessibles en ecriture : etat, journal, cache Python.
ReadWritePaths=/var/lib/donchian-bot

# Empreinte mesuree : 82 Mo. La limite est un garde-fou contre une fuite, pas un
# quota serre - un OOM kill en plein envoi d'ordre serait pire que la fuite.
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=donchian-bot

[Install]
WantedBy=multi-user.target
